{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#005AA8",
					"name": "Primary Blue",
					"slug": "primary"
				},
				{
					"color": "#002244",
					"name": "Primary Dark",
					"slug": "primary-dark"
				},
				{
					"color": "#D1ECFF",
					"name": "Primary Light",
					"slug": "primary-light"
				},
				{
					"color": "#C5A059",
					"name": "Gold",
					"slug": "secondary"
				},
				{
					"color": "#d65141",
					"name": "Accent Terracotta",
					"slug": "accent"
				},
				{
					"color": "#111827",
					"name": "Dark Neutral",
					"slug": "dark-neutral"
				},
				{
					"color": "#4d4d4d",
					"name": "Muted Link Text",
					"slug": "muted"
				},
				{
					"color": "#F8F9FA",
					"name": "Light Neutral",
					"slug": "light-neutral"
				},
				{
					"color": "#F7F5F1",
					"name": "Footer Background",
					"slug": "footer-bg"
				},
				{
					"color": "#F0EEE9",
					"name": "Footer Bottom Background",
					"slug": "footer-bottom-bg"
				},
				{
					"color": "#E5E7EB",
					"name": "Border Gray",
					"slug": "border-gray"
				},
				{
					"color": "#FFFFFF",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111827",
					"name": "Contrast",
					"slug": "contrast"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
					"name": "Sans Serif (Body)",
					"slug": "sans-serif"
				},
				{
					"fontFamily": "\"Source Serif 4\", Georgia, Cambria, \"Times New Roman\", Times, serif",
					"name": "Serif (Heading)",
					"slug": "serif"
				}
			],
			"fontSizes": [
				{
					"name": "Extra Small",
					"size": "0.75rem",
					"slug": "xs"
				},
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.125rem",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "1.25rem",
					"slug": "x-large"
				},
				{
					"name": "2X Large",
					"size": "1.5rem",
					"slug": "2xl"
				},
				{
					"name": "3X Large",
					"size": "1.875rem",
					"slug": "3xl"
				},
				{
					"name": "4X Large",
					"size": "2.25rem",
					"slug": "4xl"
				}
			]
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"units": [
				"rem",
				"em",
				"%"
			],
			"spacingSizes": [
				{
					"name": "1 (0.25rem)",
					"size": "0.25rem",
					"slug": "10"
				},
				{
					"name": "2 (0.5rem)",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "3 (0.75rem)",
					"size": "0.75rem",
					"slug": "30"
				},
				{
					"name": "4 (1rem)",
					"size": "1rem",
					"slug": "40"
				},
				{
					"name": "5 (1.25rem)",
					"size": "1.25rem",
					"slug": "50"
				},
				{
					"name": "6 (1.5rem)",
					"size": "1.5rem",
					"slug": "60"
				},
				{
					"name": "8 (2rem)",
					"size": "2rem",
					"slug": "70"
				},
				{
					"name": "10 (2.5rem)",
					"size": "2.5rem",
					"slug": "80"
				},
				{
					"name": "12 (3rem)",
					"size": "3rem",
					"slug": "90"
				},
				{
					"name": "16 (4rem)",
					"size": "4rem",
					"slug": "100"
				}
			]
		},
		"layout": {
			"contentSize": "80rem",
			"wideSize": "80rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans-serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--80)",
			"margin": {
				"top": "0",
				"bottom": "0"
			},
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				":hover": {
					"color": {
					"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "0.375rem"
				},
				"spacing": {
					"padding": {
						"top": "0.625em",
						"bottom": "0.625em",
						"left": "1.5em",
						"right": "1.5em"
					}
				}
			}
		},
		"blocks": {
			"core/group": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--40)"
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--70)"
				}
			},
			"core/post-template": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--50)"
				}
			}
		}
	}
}