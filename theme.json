{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#003366",
					"name": "Primary Blue",
					"slug": "primary"
				},
				{
					"color": "#002244",
					"name": "Primary Dark",
					"slug": "primary-dark"
				},
				{
					"color": "#E6ECF2",
					"name": "Primary Light",
					"slug": "primary-light"
				},
				{
					"color": "#C5A059",
					"name": "Gold",
					"slug": "secondary"
				},
				{
					"color": "#D32F2F",
					"name": "Red Accent",
					"slug": "accent"
				},
				{
					"color": "#111827",
					"name": "Dark Neutral",
					"slug": "dark-neutral"
				},
				{
					"color": "#6B7280",
					"name": "Muted Text",
					"slug": "muted"
				},
				{
					"color": "#F8F9FA",
					"name": "Light Neutral",
					"slug": "light-neutral"
				},
				{
					"color": "#FAFAFA",
					"name": "Background Alt",
					"slug": "background-alt"
				},
				{
					"color": "#E5E7EB",
					"name": "Border Gray",
					"slug": "border-gray"
				},
				{
					"color": "#FFFFFF",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111827",
					"name": "Contrast",
					"slug": "contrast"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
					"name": "Sans Serif (Body)",
					"slug": "sans-serif"
				},
				{
					"fontFamily": "\"Source Serif 4\", Georgia, Cambria, \"Times New Roman\", Times, serif",
					"name": "Serif (Heading)",
					"slug": "serif"
				}
			],
			"fontSizes": [
				{
					"name": "Xs",
					"size": "0.75rem",
					"slug": "xs"
				},
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "1.5rem",
					"slug": "x-large"
				},
				{
					"name": "XXL",
					"size": "2rem",
					"slug": "xx-large"
				},
				{
					"name": "Huge",
					"size": "2.5rem",
					"slug": "huge"
				}
			]
		},
		"layout": {
			"contentSize": "75rem",
			"wideSize": "80rem"
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"spacingSizes": [
				{
					"name": "1",
					"size": "0.25rem",
					"slug": "10"
				},
				{
					"name": "2",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "3",
					"size": "0.75rem",
					"slug": "30"
				},
				{
					"name": "4",
					"size": "1rem",
					"slug": "40"
				},
				{
					"name": "5",
					"size": "1.5rem",
					"slug": "50"
				},
				{
					"name": "6",
					"size": "2rem",
					"slug": "60"
				},
				{
					"name": "7",
					"size": "2.5rem",
					"slug": "70"
				},
				{
					"name": "8",
					"size": "3rem",
					"slug": "80"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans-serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "0.375rem"
				},
				"spacing": {
					"padding": {
						"top": "0.625rem",
						"bottom": "0.625rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "0.375rem"
				}
			},
			"core/heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "700"
				}
			},
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.6"
				}
			},
			"core/group": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)"
					}
				}
			}
		}
	}
}
