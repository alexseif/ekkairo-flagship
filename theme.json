{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#003366",
					"name": "Primary Blue",
					"slug": "primary"
				},
				{
					"color": "#C5A059",
					"name": "Gold",
					"slug": "secondary"
				},
				{
					"color": "#D32F2F",
					"name": "Red Accent",
					"slug": "accent"
				},
				{
					"color": "#1A1A1A",
					"name": "Dark Neutral",
					"slug": "dark-neutral"
				},
				{
					"color": "#F4F6F8",
					"name": "Light Neutral",
					"slug": "light-neutral"
				},
				{
					"color": "#FFFFFF",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#1A1A1A",
					"name": "Contrast",
					"slug": "contrast"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
					"name": "System Sans",
					"slug": "sans-serif"
				},
				{
					"fontFamily": "Georgia, Cambria, \"Times New Roman\", Times, serif",
					"name": "Serif",
					"slug": "serif"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.5rem",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "2rem",
					"slug": "x-large"
				},
				{
					"name": "XXL",
					"size": "3rem",
					"slug": "xx-large"
				}
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"spacingSizes": [
				{
					"name": "1",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "2",
					"size": "1rem",
					"slug": "30"
				},
				{
					"name": "3",
					"size": "1.5rem",
					"slug": "40"
				},
				{
					"name": "4",
					"size": "2.5rem",
					"slug": "60"
				},
				{
					"name": "5",
					"size": "4rem",
					"slug": "80"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans-serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans-serif)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "4px"
				}
			},
			"core/heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontWeight": "700"
				}
			},
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.6"
				}
			},
			"core/group": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)"
					}
				}
			}
		}
	}
}
