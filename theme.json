{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#003366",
					"name": "Primary Blue",
					"slug": "primary"
				},
				{
					"color": "#002244",
					"name": "Primary Dark",
					"slug": "primary-dark"
				},
				{
					"color": "#E6ECF2",
					"name": "Primary Light",
					"slug": "primary-light"
				},
				{
					"color": "#C5A059",
					"name": "Gold",
					"slug": "secondary"
				},
				{
					"color": "#d65141",
					"name": "Red Accent",
					"slug": "accent"
				},
				{
					"color": "#111827",
					"name": "Dark Neutral",
					"slug": "dark-neutral"
				},
				{
					"color": "#4d4d4d",
					"name": "Muted Link Text",
					"slug": "muted"
				},
				{
					"color": "#F8F9FA",
					"name": "Light Neutral",
					"slug": "light-neutral"
				},
				{
					"color": "#E5E7EB",
					"name": "Border Gray",
					"slug": "border-gray"
				},
				{
					"color": "#FFFFFF",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111827",
					"name": "Contrast",
					"slug": "contrast"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
					"name": "Sans Serif (Body)",
					"slug": "sans-serif"
				},
				{
					"fontFamily": "\"Source Serif 4\", Georgia, Cambria, \"Times New Roman\", Times, serif",
					"name": "Serif (Heading)",
					"slug": "serif"
				}
			],
			"fontSizes": [
				{
					"name": "Xs",
					"size": "0.75rem",
					"slug": "xs"
				},
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "1.5rem",
					"slug": "x-large"
				}
			]
		},
		"layout": {
			"contentSize": "75rem",
			"wideSize": "80rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans-serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "#4d4d4d"
				},
				":hover": {
					"color": {
						"text": "#d65141"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "700"
				}
			}
		}
	}
}
